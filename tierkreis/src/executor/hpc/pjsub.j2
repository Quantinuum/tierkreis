#!/bin/bash
#
# PJSUB Job Script generated by TIERKREIS

# --- Core Job Specifications ---
#PJM -N {{ job.name }}
#PJM -L "elapse={{ job.walltime }}"
#PJM -L "node={{ job.resources.nodes }}"
{% if job.resources.memory_per_node_gb %}#PJM -L "node-mem={{ job.resources.memory_per_node_gb }}Gi"
{% endif %}{% if job.resources.gpus_per_node %}#PJM -L "gpu={{ job.resources.gpus_per_node }}"
{% endif %}{% if job.queue %}#PJM -L "rscgrp={{ job.queue }}"
{% endif %}
# --- User Details ---
{% if job.account %}#PJM -g {{ job.account }}
{% endif %}{% if job.user and job.user.mail %}#PJM -m e
#PJM --mail-list {{ job.user.mail }}
{% endif %}
# --- Output and Error Handling ---
{% if job.error_path %}#PJM -e {{ job.error_path }}
{% else %}#PJM -j
{% endif %}
{% if job.output_path %}#PJM -o {{ job.output_path }}
{% else %}#PJM -o ./{{ job.name }}.out
{% endif %}
# --- MPI ---
{% if job.mpi and job.mpi.proc %}#PJM --mpi "proc={{ job.mpi.proc }}"
{% endif %}{% if job.mpi and job.mpi.max_proc_per_node %}#PJM --mpi "max-proc-per-node={{ job.mpi.max_proc_per_node }}"
{% endif %}
# --- User-Specific Arguments ---
{% for option, value in job.extra_scheduler_args|items %}#PJM {{ option }}{% if value %} {{ value }}{% endif %}
{% endfor %}{% if "-z" not in job.extra_scheduler_args %}#PJM -z jid
{% endif %}
# --- Environment Setup ---
{% for name, value in job.environment|items %}#PJM -x "{{ name }}"="{{ value }}"
{% endfor %}
# --- Load Modules ---
{% for module in job.modules %}module load {{ module }}
{% endfor %}
# --- User Command ---
{% if job.mpi %}mpiexec {{ job.command }}
{% else %}{{ job.command }}
{% endif %}
