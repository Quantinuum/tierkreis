#!/bin/sh

# SLURM Job Script generated by TIERKREIS

# --- Core Job Specifications ---
#SBATCH --job-name={{ job.name }}
#SBATCH --time={{ job.walltime }}
#SBATCH --nodes={{ job.resources.nodes }}
{% if job.resources.cores_per_node %}#SBATCH --cpus-per-task={{ job.resources.cores_per_node }}
{% endif %}{% if job.resources.memory_per_node_gb %}#SBATCH --mem={{ job.resources.memory_per_node_gb }}G
{% endif %}{% if job.resources.gpus_per_node %}#SBATCH --gpus-per-node={{ job.resources.gpus_per_node }}
{% endif %}{% if job.resources.gres %}#SBATCH --gres={{ job.resources.gres|join(',') }}
{% endif %}{% if job.resources.qpus %}#SBATCH --qpu={{ job.resources.qpus|join(',') }}
{% endif %}
{% if job.queue %}#SBATCH --partition={{ job.queue }}
{% endif %}
# --- User Details ---
{% if job.account %}#SBATCH --account={{ job.account }}
{% endif %}{% if job.user and job.user.mail %}#SBATCH --mail-type=END
#SBATCH --mail-user={{ job.user.mail }}
{% endif %}
# --- Output and Error Handling ---
{% if job.error_path %}#SBATCH --error={{ job.error_path }}
{% endif %}{% if job.output_path %}#SBATCH --output={{ job.output_path }}
{% endif %}
# --- MPI ---
{% if job.mpi and job.mpi.proc %}#SBATCH --ntasks={{ job.mpi.proc }}
{% endif %}{% if job.mpi and job.mpi.max_proc_per_node %}#SBATCH --ntasks-per-node={{ job.mpi.max_proc_per_node }}
{% endif %}
# --- User-Specific Arguments ---
{% for option, value in job.extra_scheduler_args|items %}#SBATCH {{ option }}{% if value %} {{ value }}{% endif %}
{% endfor %}
# --- Environment Setup ---
{% for name, value in job.environment|items %}export {{ name }}={{ value }}
{% endfor %}
#SBATCH --export=ALL
# --- Load Modules ---
{% for module in job.modules %}module load {{ module }}
{% endfor %}
# --- User Command ---
{% if job.mpi %}eval mpiexec {{ job.command }}
{% else %}{{ job.command }}
{% endif %}
