sphinx_opts  := "-T"
sphinx_build := "sphinx-build"
source_dir   := "source"
build_dir    := "build"

default:
  @just --list

uvrun profile +ARGS:
  uv run --all-extras --config-settings-package tierkreis:build-args='--profile {{profile}}' {{ARGS}}

build profile:
  just uvrun {{profile}} env UV_NO_SYNC=1 {{sphinx_build}} -M html "{{source_dir}}" "{{build_dir}}" {{sphinx_opts}}
